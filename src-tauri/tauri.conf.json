{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "App Password",
  "mainBinaryName": "app-password",
  "version": "0.1.3",
  "identifier": "com.local.apppassword",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'"
    },
    "windows": [
      {
        "label": "main",
        "title": "App Password",
        "width": 1040,
        "height": 720,
        "minWidth": 760,
        "minHeight": 560,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": true
      }
    ]
  },
  "bundle": {
  "active": true,
  "targets": "all",
  "icon": [
    "icons/32x32.png",
    "icons/128x128.png",
    "icons/128x128@2x.png",
    "icons/icon.icns",
    "icons/icon.ico"
  ],
  "shortDescription": "Windows 앱을 마스터 비밀번호로 보호",
  "longDescription": "App Password는 Windows 보호 서비스와 연결해 선택한 응용 프로그램의 직접 실행을 감지하고 마스터 비밀번호로 보호합니다."
}
}
